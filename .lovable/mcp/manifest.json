        "description": "List the Islamic courses offered by the school, with level, duration and class size. Optionally filter by a keyword.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "description": "Optional keyword to filter courses by title or description."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_sessions",
        "title": "List class sessions",
        "description": "List scheduled class sessions with days, times, location and teacher. Optionally filter by schedule type or keyword.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "Regular",
                "Weekly",
                "Weekend"
              ],
              "description": "Optional schedule type filter."
            },
            "query": {
              "type": "string",
              "description": "Optional keyword to match session title, teacher or location."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
