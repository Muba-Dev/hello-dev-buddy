        "inputSchema": {
          "type": "object",
          "properties": {
            "program": {
              "type": "string",
              "description": "Optional program name to filter the fee structure."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_enrollment_info",
