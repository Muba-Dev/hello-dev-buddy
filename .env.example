# Supabase project used by the web app and the MCP OAuth issuer.
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Edge function secrets -------------------------------------------------
# These are NOT read by Vite. Set them on the project with:
#   supabase secrets set RESEND_API_KEY=... ADMISSION_ALERT_EMAIL=...
# Values below are listed here only as a deployment checklist.

# Email notifications (Resend). Optional — alerts are logged if unset.
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=
ADMISSION_ALERT_EMAIL=

# WhatsApp Cloud API admin alert. Optional — alerts are logged if unset.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_API_VERSION=v19.0
ADMISSIONS_WHATSAPP_NUMBER=
